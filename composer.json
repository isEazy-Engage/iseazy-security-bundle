{
  "name": "iseazy/security",
  "type": "symfony-bundle",
  "autoload": {
    "psr-4": {
      "Iseazy\\Security\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jose Suarez Bravo"
    }
  ],
  "require": {
    "php": ">=8.3",
    "symfony/security-http": "^7.4",
    "symfony/config": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/yaml": "^7.4",
    "firebase/php-jwt": "v7.0.5",
    "symfony/http-foundation": "^7.4",
    "symfony/security-bundle": "^7.4",
    "symfony/uid": "^7.4",
    "symfony/cache": "^7.4",
    "symfony/http-client": "^7.4",
    "psr/cache": "3.0.0",
    "psr/log": "3.0.2",
    "symfony/http-kernel": "^7.4",
    "symfony/security-core": "^7.4"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "cs": "phpcs --standard=PSR12 src tests",
    "cbf": "phpcbf --standard=PSR12 src tests"
  }
}
