{
  "name": "iseazy/security",
  "type": "symfony-bundle",
  "version": "2.0.0",
  "autoload": {
    "psr-4": {
      "Iseazy\\Security\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jose Suarez Bravo"
    }
  ],
  "require": {
    "php": ">=8.3",
    "symfony/security-http": "v6.4.41",
    "symfony/config": "v6.4.37",
    "symfony/dependency-injection": "v6.4.38",
    "symfony/yaml": "v6.4.41",
    "firebase/php-jwt": "v7.0.5",
    "symfony/http-foundation": "v6.4.41",
    "symfony/security-bundle": "v6.4.41",
    "symfony/uid": "v6.4.32",
    "symfony/cache": "v6.4.41",
    "symfony/http-client": "v6.4.41",
    "psr/cache": "3.0.0",
    "psr/log": "3.0.2"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.0.*"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "4.0.1"
  },
  "scripts": {
    "cs": "phpcs --standard=PSR12 src tests",
    "cbf": "phpcbf --standard=PSR12 src tests"
  }
}
